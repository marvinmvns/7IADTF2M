        "summary": "Obter detalhes de experimento específico",
        "description": "Retorna todos os detalhes de um experimento pelo seu ID.",
        "operationId": "get_experiment_experiments__experiment_id__get",
        "parameters": [
          {
            "name": "experiment_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Experiment Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Experimento encontrado",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "404": {
            "description": "Experimento não encontrado"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "experiments"
        ],
        "summary": "Deletar experimento específico",
        "description": "Remove um experimento específico pelo seu ID.",
        "operationId": "delete_experiment_experiments__experiment_id__delete",
        "parameters": [
          {
            "name": "experiment_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Experiment Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Experimento removido com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteResponse"
                }
              }
            }
          },
          "404": {
            "description": "Experimento não encontrado"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/experiments/all": {
      "delete": {
        "tags": [
          "experiments"
        ],
        "summary": "Limpar todo histórico de experimentos",
        "description": "**ATENÇÃO:** Remove TODOS os experimentos do banco de dados. Esta operação é irreversível.\n\n    Use este endpoint para limpar o histórico completo de experimentos.",
        "operationId": "delete_all_experiments_experiments_all_delete",
        "responses": {
          "200": {
            "description": "Histórico limpo com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteResponse"
                }
              }
            }
          },
          "500": {
            "description": "Erro ao limpar histórico"
          }
        }
      }
    },
    "/experiments/failed": {
      "delete": {
        "tags": [
          "experiments"
        ],
        "summary": "Remover experimentos falhados",
        "description": "Remove apenas os experimentos com status 'failed', mantendo os demais intactos.",
        "operationId": "delete_failed_experiments_experiments_failed_delete",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteResponse"
                }
              }
